# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is where your secrets live locally — keep it out of git
# (add it to .gitignore) and never commit it.

project_name = "ncsm-store"
environment  = "prod"
location     = "malaysiawest"

# --- PostgreSQL ---
postgres_admin_username = "ncsmadmin"
postgres_admin_password = "CHANGE-ME-use-a-strong-generated-password"

# --- Container images ---
# Placeholders until CI pushes real images to the ACR this module creates.
# After the first push, update these and re-apply (or wire your CI/CD to do it).
web_app_docker_image    = "ncsm-store-web:latest"
worker_app_docker_image = "ncsm-store-worker:latest"

# --- GKash / SMTP ---
# Safe to leave blank on first apply — placeholders get written to Key Vault
# and you fill in the real values afterward via `az keyvault secret set`.
gkash_merchant_key = ""
gkash_secret_key   = ""
smtp_username      = ""
smtp_password      = ""

# --- Monitoring ---
alert_email       = "ops@bavion.example"   # budget + (if enabled) Defender alerts
budget_amount_usd = 180
budget_start_date = "2026-10-01T00:00:00Z" # must be the 1st of a month, not in the past

# --- Optional ---
allowed_admin_ip          = ""     # e.g. "203.0.113.10" to allow direct psql access for migrations
enable_defender_for_cloud = false  # subscription-wide — confirm with NCSM's Azure admin first
